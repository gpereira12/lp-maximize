---
// Seção 9: Fale Conosco (Fechamento sem Atrito e Contato Direto)
const whatsappUrl = import.meta.env.PUBLIC_WHATSAPP_URL || "https://wa.me/5511999999999?text=Olá,%20gostaria%20de%20entender%20como%20atrair%20pacientes%20particulares%20via%20Google%20Ads%20para%20minha%20clínica.";
---

<section id="contato" class="cta-section section">
  <div class="container cta-section__container fade-in-up">
    <span class="tagline">Atendimento Executivo</span>
    
    <h2 class="cta-section__headline">
      Vamos estruturar o Google Ads da sua clínica?
    </h2>

    <p class="cta-section__desc">
      Toque no botão abaixo para conversar direto com a nossa equipe no WhatsApp. Vamos entender o seu momento atual, avaliar o potencial de buscas da sua especialidade no Google e apresentar uma proposta clara para atrair pacientes particulares para a sua clínica. Sem jargões complicados, focado 100% no seu retorno.
    </p>

    <div class="cta-section__action">
      <!-- Link direto para o WhatsApp da Maximize -->
      <a 
        href={whatsappUrl} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="btn btn--primary btn--whatsapp"
      >
        <svg class="whatsapp-icon" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
        </svg>
        Falar com um Especialista no WhatsApp
      </a>
      
      <span class="cta-section__microcopy">
        Respostas rápidas e atendimento direto com estrategistas.
      </span>
    </div>
  </div>
</section>

<style>
  .cta-section {
    background-color: var(--color-bg); /* Alterado para Fundo Claro */
    text-align: center;
    position: relative;
    border-top: 1px solid rgba(44, 62, 42, 0.08);
  }

  .cta-section__container {
    max-width: 800px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cta-section__headline {
    font-size: clamp(2rem, 4vw, 3.25rem);
    color: var(--color-primary); /* Texto em verde musgo */
    margin-bottom: 1.5rem;
    font-weight: 800;
  }

  .cta-section__desc {
    font-size: 1.15rem;
    color: var(--color-primary);
    opacity: 0.8;
    margin-bottom: 3rem;
  }

  .cta-section__action {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
  }

  .btn--whatsapp {
    background-color: var(--color-primary); /* Botão verde musgo destacado */
    color: var(--color-bg);
    width: 100%;
    max-width: 450px;
    box-shadow: 0 4px 15px rgba(44, 62, 42, 0.15);
  }

  .btn--whatsapp:hover {
    background-color: var(--color-accent-dark, #a68b65); /* Hover em dourado */
    color: var(--color-primary);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(166, 139, 101, 0.25);
  }

  .whatsapp-icon {
    fill: currentColor;
    transition: transform var(--transition-fast);
  }

  .btn--whatsapp:hover .whatsapp-icon {
    transform: scale(1.1);
  }

  .cta-section__microcopy {
    font-size: 0.85rem;
    color: var(--color-primary);
    opacity: 0.5;
  }
</style>

